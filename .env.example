# Copy to .env and fill in. run.sh loads this automatically.

# OpenAI API key (required for analysis)
OPENAI_API_KEY=sk-...

# Model for entity-sentiment extraction.
# Default is gpt-4.1-nano; see docs/SEEDING_AND_MODELS.md for cheaper current options.
OPENAI_MODEL=gpt-4.1-nano

# Daily OpenAI spend limit in USD (checked by the batch analyzer).
# NOTE: the price table backing this is stale — see docs/SEEDING_AND_MODELS.md.
OPENAI_DAILY_LIMIT=50

# Postgres connection. ./run.sh docker up uses postgres:postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/news_bias

# Articles fetched per RSS feed per scraper run
SCRAPER_LIMIT_PER_FEED=5

# Set to 1 to inject already-tracked canonical entity names into extraction
# prompts (entity-resolution layer 0; validate on a pilot batch first).
# See docs/ROADMAP_IDEAS_2026.md section 12.
KNOWN_ENTITY_INJECTION=0

LOG_LEVEL=INFO
