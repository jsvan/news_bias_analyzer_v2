# Dev-mode default: talk to the live API on the family server (Tailscale IP),
# so frontend work never needs a local backend running. Loaded only by
# `npm run dev` (Vite development mode); the production/server build sets
# VITE_API_BASE_URL=/api in deploy/Dockerfile.web, which overrides env files.
# To use a local backend instead, override in frontend/.env.development.local
# (gitignored).
VITE_API_BASE_URL=http://100.100.142.12:8000
