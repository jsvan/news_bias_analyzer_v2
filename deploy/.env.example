# Copy to deploy/.env on the server. deploy/.env is gitignored — never commit it.

# Required. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# Required for the scheduler (batch analyzer). Copy from the Mac's .env.
OPENAI_API_KEY=

# Host paths (defaults match the server layout created by server_setup.sh)
PGDATA_DIR=/srv/news_bias/pgdata
LOGS_DIR=/srv/news_bias/logs
BATCHES_DIR=/srv/news_bias/batches

# Where nightly dumps are written (on the root disk, next to the data).
BACKUP_DIR=/srv/news_bias/backups

# External backup drive (second copy of every dump). On this server: /backup (1.8T).
# server_setup.sh creates the marker file; the backup FAILS LOUDLY if it's missing
# (i.e. the drive isn't mounted).
OFFSITE_DIR=/backup/news_bias

# Optional extra: rclone remote for a cloud copy, e.g. "b2:news-bias-backups".
# The external drive survives a disk failure but not fire/theft/surge.
RCLONE_REMOTE=

# Retention
KEEP_DAILY=14
KEEP_WEEKLY=8
